<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>海与梦与蒙太奇 · 秘密</title>
    <style>
        body {
            background: #0a0a0a;
            color: #e0e0e0;
            font-family: 'Georgia', 'Times New Roman', serif;
            text-align: center;
            padding: 2rem;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }
        .container {
            max-width: 650px;
            width: 100%;
            border: 1px solid #333;
            padding: 2rem;
            background: #111;
            box-shadow: 0 0 20px rgba(0,0,0,0.5);
        }
        h1 {
            font-size: 1.8rem;
            letter-spacing: 2px;
            border-bottom: 1px solid #333;
            display: inline-block;
            padding-bottom: 0.5rem;
        }
        input {
            background: #222;
            border: 1px solid #444;
            color: #eee;
            padding: 0.6rem 1rem;
            font-size: 1rem;
            margin-top: 1.5rem;
            width: 80%;
            font-family: monospace;
            text-align: center;
        }
        button {
            background: #2a2a2a;
            border: 1px solid #666;
            color: #ddd;
            padding: 0.6rem 1.5rem;
            margin-top: 1rem;
            cursor: pointer;
            transition: 0.2s;
            font-family: inherit;
        }
        button:hover {
            background: #3a3a3a;
            border-color: #888;
        }
        .hidden {
            display: none;
        }
        #secret {
            margin-top: 2rem;
            padding-top: 1rem;
            border-top: 1px solid #333;
            line-height: 1.6;
            text-align: left;
        }
        .error {
            color: #a66;
            margin-top: 1rem;
            font-size: 0.9rem;
        }
        footer {
            margin-top: 2rem;
            font-size: 0.7rem;
            color: #555;
        }
        /* 游戏内样式 */
        .story-text {
            margin-bottom: 1.5rem;
            white-space: pre-wrap;
        }
        .options {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
            margin-top: 1rem;
        }
        .options button {
            text-align: left;
            background: #1a1a1a;
            border-color: #3a3a3a;
        }
        .custom-input {
            margin-top: 1rem;
            padding: 0.5rem;
            background: #222;
            border: 1px solid #444;
            color: #eee;
            width: 100%;
            font-family: monospace;
        }
        .reset-btn {
            margin-top: 2rem;
            text-align: center;
        }
        hr {
            border-color: #2a2a2a;
            margin: 1rem 0;
        }
        .click-hint {
            display: inline-block;
            margin-left: 10px;
            font-size: 1.2rem;
            animation: blink 1s infinite;
            cursor: pointer;
        }
        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }
        .story-line {
            margin-bottom: 0.8rem;
            cursor: pointer;
        }
        .story-line.hidden-line {
            display: none;
        }
    </style>
</head>
<body>
<div class="container">
    <h1>海与梦与蒙太奇</h1>
    <p>七个字母，七个瞬间。<br>你已找到答案？</p>
    <input type="text" id="codeInput" placeholder="输入字母序列" autocomplete="off">
    <br>
    <button onclick="checkCode()">开启</button>
    <div id="errorMsg" class="error"></div>
    <div id="secret" class="hidden">
        <!-- 游戏将动态渲染在此 -->
    </div>
    <footer>
        梦境并非虚幻，遗忘只是另一种记得。<br>
        <span style="color: #444;">如果遇到bug或困难，欢迎加企鹅 1102168205</span>
    </footer>
</div>

<script>
    // 正确答案（七个字母组成的单词，小写）
    const CORRECT_CODE = "vigilia";  // ← 请替换成你设计的七个字母单词

    // ---------- 游戏数据 ----------
    const letters = {
        formal: `卡芙卡：
　二相乐园近日有新设的鬼屋与通宵影院，附有情侣套票优惠。三月七言此活动适合二人同行，无关情侣之名分。若你不弃，不知能否拨冗同往？如有闲暇，明日午后三时，我在二维市的大桥下等你。
　——星`,
        bomb: `卡芙卡！！！我在收到一张游乐园传单，情侣套票打五折！！！不管怎样，不去就好像亏了！！！`,
        casual: `明天你有空吗。我本来约了三月丹恒他们，但他们好像都临时有事。游乐园的票已经买了，不去有些浪费。你要是碰巧路过的话，要不就明天下午三点二维市的大桥下见？
落款：星（涂改痕迹）`
    };
    const packages = {
        fancy: "华丽的花纹和贵重的火漆仔细包装，像封存一份正式的情书。",
        cute: "一张漂亮可爱的卡通信封，封面印着一只毛茸茸的小狗，耳朵耷拉下来，遮住半张脸。",
        plain: "不用信封，直接把信纸折好，就这样寄出去。赤诚是最好的包装，信的折痕就是它唯一的信封。"
    };

    let gameState = {
        step: null,   // 'choosePick', 'chooseLetter', 'choosePackage', 'finalSend', 'ended'
        chosenLetter: null,
        chosenPackage: null,
        customText: null,
        endedMessage: null,
        // 段落逐步显示相关
        currentParagraphIndex: 0,
        paragraphs: []
    };

    // 通用：渲染带点击显示段落的界面
    function renderParagraphs(container, paragraphs, onComplete) {
        container.innerHTML = '';
        for (let i = 0; i < paragraphs.length; i++) {
            const p = document.createElement('div');
            p.className = 'story-line' + (i === 0 ? '' : ' hidden-line');
            p.innerHTML = paragraphs[i];
            container.appendChild(p);
        }
        // 添加提示符号
        const hintSpan = document.createElement('span');
        hintSpan.className = 'click-hint';
        hintSpan.innerHTML = ' ▼';
        container.appendChild(hintSpan);
        let currentIndex = 0;
        const revealNext = () => {
            if (currentIndex < paragraphs.length - 1) {
                currentIndex++;
                container.children[currentIndex].classList.remove('hidden-line');
            } else {
                // 全部显示完毕，移除提示并调用完成回调
                hintSpan.remove();
                if (onComplete) onComplete();
            }
        };
        hintSpan.addEventListener('click', revealNext);
        // 点击任何已显示的行也可以继续
        for (let i = 0; i <= currentIndex; i++) {
            container.children[i].addEventListener('click', revealNext);
        }
    }

    function renderGame() {
        const secretDiv = document.getElementById('secret');
        secretDiv.classList.remove('hidden');
        if (gameState.step === null) {
            gameState.step = 'choosePick';
        }
        updateGameUI();
    }

    function updateGameUI() {
        const secretDiv = document.getElementById('secret');
        if (gameState.step === 'choosePick') {
            const paragraphs = [
                "你成功剪辑了艾利欧给你的原片。很好，你很聪明——你抓住了命运的马脚。",
                "现在，你暂时超脱了那个被固定在开拓者眼中的狭窄视角。此刻，你是幽灵，是风，又或者，丘比特？总之，你是专为这一封信而来的无名力量。",
                "你要做的事很简单。当然，你也有不为剧本服务的权力。你可以转身离开，当这一切都没发生过。",
                "你正飘浮在这间只亮着一盏小灯的房间里。桌边趴着一个灰头发的女孩，她已经睡着了，眉头却还皱着，看起来有些心烦意乱。旁边的垃圾桶里，有几团揉皱的纸，看得出来，都被反复捏过，又反复展开，最后还是一狠心丢进去了。",
                "你不知道什么事能让她烦恼至此。但你能感到——那张纸上还残留着某种温热的、笨拙的、被主人自己否决了的东西。它正在垃圾桶的阴影里，安静地等待一个结局。",
                "<strong>你要把它捡起来吗？</strong>"
            ];
            secretDiv.innerHTML = '<div id="storyContainer"></div><div class="options" id="pickOptions" style="display:none;"></div>';
            const container = document.getElementById('storyContainer');
            const optionsDiv = document.getElementById('pickOptions');
            renderParagraphs(container, paragraphs, () => {
                // 显示选项按钮
                optionsDiv.style.display = 'flex';
                optionsDiv.innerHTML = `
                    <button data-pick="yes1">管这管那的，这封信不该待在垃圾桶里</button>
                    <button data-pick="yes2">你不太确定里面写了什么，但你的直觉告诉你，能被揉成这样又没被撕碎的东西，大概很重要。</button>
                    <button data-pick="no">就让它在垃圾桶里待着吧，有些信注定不该被寄出。</button>
                `;
                document.querySelectorAll('#pickOptions button').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        const choice = btn.getAttribute('data-pick');
                        if (choice === 'no') {
                            gameState.step = 'ended';
                            gameState.endedMessage = "那张纸继续蜷在垃圾桶的阴影里，像一个还没说出口就被咽回去的逗号。你退出了房间，在风中消散。明天下午三点，二维市的大桥下不会有人来。也许这样也好。不是每封信都必须被寄出，不是每份心意都必须被看见。<br><br>[游戏结束。你可以随时回来。]";
                            updateGameUI();
                        } else {
                            gameState.step = 'chooseLetter';
                            updateGameUI();
                        }
                    });
                });
            });
        } 
        else if (gameState.step === 'chooseLetter') {
            const paragraphs = [
                "你轻轻飘进垃圾桶。那张最皱的纸慢慢展开了。字歪歪扭扭，有些地方被涂改过，有些地方被水渍晕开（是饮料？是泪？或者是趴着睡流淌而出的口水？你看不出来）。星写了不止一版，桌角还散着另外几张草稿，像同一个人进入不同的角色换了三种语气，练习同一句话。",
                "每一份都是真心，只是穿了不同的外衣。你只能替她寄出一封。你会选哪一封？"
            ];
            secretDiv.innerHTML = '<div id="storyContainer"></div><div class="options" id="letterOptions" style="display:none;"></div>';
            const container = document.getElementById('storyContainer');
            const optionsDiv = document.getElementById('letterOptions');
            renderParagraphs(container, paragraphs, () => {
                optionsDiv.style.display = 'flex';
                optionsDiv.innerHTML = `
                    <button data-letter="formal">工整的信：<br>${letters.formal.substring(0, 80)}…</button>
                    <button data-letter="bomb">彩色炸弹：<br>${letters.bomb}</button>
                    <button data-letter="casual">随意的信：<br>${letters.casual.substring(0, 80)}…</button>
                `;
                document.querySelectorAll('#letterOptions button').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const letterKey = btn.getAttribute('data-letter');
                        gameState.chosenLetter = letterKey;
                        gameState.step = 'choosePackage';
                        updateGameUI();
                    });
                });
            });
        }
        else if (gameState.step === 'choosePackage') {
            const letterContent = letters[gameState.chosenLetter];
            const paragraphs = [
                `<strong>你选定了信：</strong><br>${letterContent}`,
                "你可以为它添加一点点润色，也可以什么也不加。"
            ];
            secretDiv.innerHTML = '<div id="storyContainer"></div><div class="options" id="packageOptions" style="display:none;"></div>';
            const container = document.getElementById('storyContainer');
            const optionsDiv = document.getElementById('packageOptions');
            renderParagraphs(container, paragraphs, () => {
                optionsDiv.style.display = 'flex';
                optionsDiv.innerHTML = `
                    <button id="customEditBtn">✏️ 自定义修改内容</button>
                    <button id="noEditBtn">什么也不加。这样就够好了。</button>
                    <button id="changeLetterBtn">等等，要不还是换一封吧。</button>
                `;
                document.getElementById('customEditBtn')?.addEventListener('click', () => {
                    // 进入自定义编辑界面
                    secretDiv.innerHTML = `<div class="story-text">修改信的内容：</div>
                        <textarea id="customText" class="custom-input" rows="4" placeholder="在这里写下你想修改的信的内容...">${letterContent}</textarea>
                        <div class="options">
                            <button id="applyCustom">应用修改并继续</button>
                            <button id="cancelCustom">返回</button>
                        </div>`;
                    document.getElementById('applyCustom')?.addEventListener('click', () => {
                        const newText = document.getElementById('customText').value;
                        if (newText.trim()) gameState.customText = newText.trim();
                        gameState.step = 'finalSend';
                        updateGameUI();
                    });
                    document.getElementById('cancelCustom')?.addEventListener('click', () => {
                        gameState.step = 'choosePackage';
                        updateGameUI();
                    });
                });
                document.getElementById('noEditBtn')?.addEventListener('click', () => {
                    gameState.step = 'finalSend';
                    updateGameUI();
                });
                document.getElementById('changeLetterBtn')?.addEventListener('click', () => {
                    // 回到选信步骤
                    gameState.step = 'chooseLetter';
                    gameState.customText = null;
                    updateGameUI();
                });
            });
        }
        else if (gameState.step === 'finalSend') {
            const finalLetter = gameState.customText || letters[gameState.chosenLetter];
            const paragraphs = [
                `<strong>信已备好：</strong><br>${finalLetter}`,
                "现在，你要如何将它寄出？"
            ];
            secretDiv.innerHTML = '<div id="storyContainer"></div><div class="options" id="sendOptions" style="display:none;"></div>';
            const container = document.getElementById('storyContainer');
            const optionsDiv = document.getElementById('sendOptions');
            renderParagraphs(container, paragraphs, () => {
                optionsDiv.style.display = 'flex';
                optionsDiv.innerHTML = `
                    <button data-pkg="fancy">${packages.fancy}</button>
                    <button data-pkg="cute">${packages.cute}</button>
                    <button data-pkg="plain">${packages.plain}</button>
                    <button data-pkg="cancel">算了，还是让它留在垃圾桶里吧。也许星是对的，也许这封信不该被寄出。</button>
                    <button id="backToLetter">等等，要不还是换一封吧。</button>
                `;
                document.querySelectorAll('[data-pkg]').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const pkg = btn.getAttribute('data-pkg');
                        if (pkg === 'cancel') {
                            gameState.step = 'ended';
                            gameState.endedMessage = "你把信纸重新揉成一团，轻轻放回垃圾桶里。你退出了房间，在风中消散。明天下午三点，二维市的大桥下不会有人来。也许这样也好。不是每封信都必须被寄出，不是每份心意都必须被看见。<br><br>[游戏结束。你可以随时回来。]";
                            updateGameUI();
                        } else {
                            gameState.chosenPackage = pkg;
                            gameState.step = 'ended';
                            gameState.endedMessage = `你寄出了这封信。无论你选了哪一份草稿，加上了什么样的痕迹，把它装进了哪一种包装——它都像一片被风托起的叶子，顺着命运的轨道，穿过种种星系的灯火，穿过被思念缠绕的夜色，穿过密密麻麻的剧本页码，落在另一间只亮着一盏小灯的房间里。<br><br>
                            好了，任务结束，你又重新回到了风里。这封信已经不再是废纸了。<br><br>
                            [游戏结束，感谢你为星做的这一切。请期待续作！]`;
                            updateGameUI();
                        }
                    });
                });
                document.getElementById('backToLetter')?.addEventListener('click', () => {
                    gameState.step = 'chooseLetter';
                    gameState.customText = null;
                    updateGameUI();
                });
            });
        }
        else if (gameState.step === 'ended') {
            secretDiv.innerHTML = `<div class="story-text">${gameState.endedMessage}</div>
                                   <div class="reset-btn"><button id="resetGame">重新开始游戏</button></div>`;
            document.getElementById('resetGame')?.addEventListener('click', () => {
                gameState = { step: 'choosePick' };
                updateGameUI();
            });
        }
    }

    // 密码验证
    function checkCode() {
        const input = document.getElementById('codeInput').value.trim().toLowerCase();
        const errorDiv = document.getElementById('errorMsg');
        const secretDiv = document.getElementById('secret');

        if (input === CORRECT_CODE) {
            errorDiv.innerHTML = "";
            document.getElementById('codeInput').disabled = true;
            const btn = document.querySelector('button[onclick="checkCode()"]');
            if (btn) btn.disabled = true;
            gameState = { step: null };
            renderGame();
        } else {
            errorDiv.innerHTML = "那并不是正确的顺序，再试试？";
            secretDiv.classList.add('hidden');
        }
    }
</script>
</body>
</html>
